APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
DATABASE_URL=postgresql+psycopg://seatsync:seatsync@postgres:5432/seatsync
TEST_DATABASE_URL=postgresql+psycopg://seatsync:seatsync@localhost:5432/seatsync_test
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://localhost:6379/15
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SMTP_HOST=mailhog
SMTP_PORT=1025
EMAIL_FROM=no-reply@seatsync.local
FRONTEND_ORIGIN=http://localhost:5173
HOLD_TTL_SECONDS=300
CANCELLATION_CUTOFF_HOURS=24
EXPORT_DIRECTORY=/app/exports
VITE_API_URL=http://localhost:8000/api/v1
# Set to 0 only on development networks that intercept registry.npmjs.org TLS.
FRONTEND_NODE_TLS_REJECT_UNAUTHORIZED=1
FRONTEND_PNPM_STRICT_SSL=true
